# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Supabase configuration (optional cloud database connection)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PAYMONGO: PayMongo Philippine Payment Gateway (GCash, Maya, Cards)
PAYMONGO_SECRET_KEY="sk_test_your_secret_key"
PAYMONGO_PUBLIC_KEY="pk_test_your_public_key"
PAYMONGO_WEBHOOK_SECRET="whsk_test_your_webhook_secret"

# VOICEFLOW: Voiceflow AI Chatbot Widget Project ID (optional)
VOICEFLOW_PROJECT_ID="your_voiceflow_project_id"

